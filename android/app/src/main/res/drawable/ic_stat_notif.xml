<!--
  Monochrome notification (status-bar) icon. Android renders small icons using only
  the alpha channel, so this is a solid-white glyph on a transparent background.

  The glyph is a "trending up" line-chart with an up arrow, matching the app's concept
  (an SMA chart with a BUY signal arrow — see /icon.svg). Do NOT derive this from
  ic_launcher_foreground.xml: that file is the stock Capacitor robot mascot, so a glyph
  extracted from it renders as the Android robot in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportHeight="24"
    android:viewportWidth="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,6l2.29,2.29 -4.88,4.88 -4,-4L2,16.59 3.41,18l6,-6 4,4 6.3,-6.29L22,12L22,6z" />
</vector>
